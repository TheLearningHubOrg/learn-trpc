{
  "name": "learn-trpc",
  "version": "1.0.0",
  "private": true,
  "description": "Starter project for the learn-trpc guide: a tRPC v11 API with Zod validation, middleware and a typed client",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "client": "tsx src/client.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@trpc/client": "^11.23.0",
    "@trpc/server": "^11.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "superjson": "^2.2.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  },
  "license": "MIT"
}
