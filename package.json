{
  "name": "learn-trpc",
  "version": "1.0.0",
  "description": "Production-grade End-to-End Typesafe API reference implementation with tRPC and Zod",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev:server": "tsx watch src/server.ts",
    "dev:client": "tsx src/client.ts",
    "test": "node --test dist/tests/*.js 2>nul || tsx --test tests/trpc.test.ts"
  },
  "dependencies": {
    "@trpc/client": "^10.45.2",
    "@trpc/server": "^10.45.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  },
  "keywords": [
    "trpc",
    "typescript",
    "typesafe",
    "api",
    "rpc",
    "zod",
    "fullstack"
  ],
  "author": "The Learning Hub",
  "license": "MIT"
}
